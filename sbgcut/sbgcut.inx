<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Cut on SBG plotter</name>
  <id>org.interop.sbgcut</id>
  <param name="tab" type="notebook">
    <page name="conn" gui-text="Connection">
      <param name="port" type="string" gui-text="Serial port (COMx or /dev/tty...)">COM12</param>
      <param name="baud" type="int" min="1200" max="1000000" gui-text="Baud">115200</param>
      <param name="dry_run" type="bool" gui-text="Dry run (write job to temp file, do not send)">false</param>
    </page>
    <page name="place" gui-text="Placement">
      <param name="x" type="float" min="0" max="2000" precision="2" gui-text="Origin X on bed (mm)">10.0</param>
      <param name="y" type="float" min="0" max="2000" precision="2" gui-text="Origin Y on bed (mm)">10.0</param>
      <param name="flip_y" type="bool" gui-text="Flip Y (SVG is top-down, machine is bottom-up)">true</param>
      <param name="bed_h" type="float" min="1" max="2000" precision="2" gui-text="Bed height (mm, used by Flip Y)">180.0</param>
      <param name="flatness" type="float" min="0.01" max="5" precision="2" gui-text="Curve flattening (mm)">0.2</param>
      <param name="selection_only" type="bool" gui-text="Only cut the selection">false</param>
    </page>
    <page name="cut" gui-text="Cut">
      <param name="speed" type="int" min="1" max="4" gui-text="Speed (1-4)">2</param>
      <param name="force" type="int" min="1" max="160" gui-text="Blade force">60</param>
      <param name="eject" type="float" min="0" max="2000" precision="1" gui-text="Eject feed after cut (mm)">0.0</param>
    </page>
  </param>
  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu><submenu name="Export"/></effects-menu>
  </effect>
  <script><command location="inx" interpreter="python">sbgcut.py</command></script>
</inkscape-extension>
